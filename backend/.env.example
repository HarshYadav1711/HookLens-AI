# HookLens AI — backend environment
# Copy to .env in this directory.

# --- App ---
APP_NAME=HookLens AI
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated browser origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Storage ---
# Sessions (JSON), audio cache, and checkpoint parent directory.
DATA_DIR=./data

# faster-whisper model when YouTube/Instagram audio must be transcribed.
# Options: tiny, base, small, medium, large-v3 (larger = slower, more accurate).
WHISPER_MODEL_SIZE=base

# --- Vector search (Qdrant) ---
# Start with: docker compose up -d  (from repo root)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=hooklens_chunks

# --- Embeddings & chunking ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_MAX_CHARS=480
CHUNK_OVERLAP_CHARS=80
RETRIEVAL_TOP_K=8

# --- LLM (Ollama) ---
# Requires: ollama serve  and  ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# LangGraph conversation checkpoints (SQLite).
CHECKPOINT_DB_PATH=./data/checkpoints.db
